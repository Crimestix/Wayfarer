{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Was das Hauptfenster darf: die Befehle der App, Ereignisse empfangen und einen Ordner auswählen. Mehr nicht.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-config-get",
    "allow-config-set",
    "allow-store-read-all",
    "allow-store-read",
    "allow-store-write",
    "allow-store-remove",
    "allow-store-watch",
    "allow-lk-status",
    "allow-lk-set-key",
    "allow-lk-clear-key",
    "allow-lk-get",
    "allow-ai-status",
    "allow-ai-set-key",
    "allow-ai-clear-key",
    "allow-ai-ask",
    "allow-media-list",
    "allow-media-fetch",
    "allow-app-close",
    "allow-sync-state",
    "allow-sync-set-key",
    "allow-sync-clear-key",
    "allow-sync-probe",
    "allow-sync-link",
    "allow-sync-recover",
    "allow-sync-scan",
    "allow-sync-fetch",
    "allow-sync-apply-begin",
    "allow-sync-apply-end",
    "allow-sync-apply-abort",
    "allow-sync-push",
    "allow-sync-mark",
    "allow-sync-aside-list",
    "allow-sync-aside-read",
    "allow-sync-aside-put",
    "allow-sync-aside-drop",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
