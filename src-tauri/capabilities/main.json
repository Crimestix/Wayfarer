{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Was das Hauptfenster darf: die Befehle der App, Ereignisse empfangen und einen Ordner auswählen. Mehr nicht.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-config-get",
    "allow-config-set",
    "allow-store-read-all",
    "allow-store-read",
    "allow-store-write",
    "allow-store-remove",
    "allow-store-watch",
    "allow-lk-status",
    "allow-lk-set-key",
    "allow-lk-clear-key",
    "allow-lk-get",
    "allow-media-list",
    "allow-media-fetch",
    "allow-app-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
